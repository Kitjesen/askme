# ─────────────────────────────────────────────────────────────
# AskMe + LiteLLM — Docker application environment template.
# ZeroClaw is opt-in only through the experimental-zeroclaw profile.
# Copy this file to docker/.env and litellm.env.example to docker/.env.litellm:
#   docker compose --env-file docker/.env --env-file docker/.env.litellm -f docker/docker-compose.yml up -d
# ─────────────────────────────────────────────────────────────

# ── LLM control plane (required) ─────────────────────────────
# Scoped application key generated by LiteLLM; never use its master key here.
LITELLM_VIRTUAL_KEY=
# Native quickstart uses loopback. Product Compose always injects
# http://litellm:4000/v1 and does not accept a remote override.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
NO_PROXY=127.0.0.1,localhost,litellm

# Required because the container HTTP surface binds to the Compose network.
ASKME_CONTROL_API_KEY=

# ── Linux edge audio (required by docker-compose.edge-linux.yml) ───────
# Keep /dev/snd unless the product host exposes a different ALSA device path.
ASKME_AUDIO_DEVICE=/dev/snd
# Resolve on the host with: getent group audio | cut -d: -f3
# The Linux edge override refuses to render while this value is empty.
ASKME_AUDIO_GID=

# ── Experimental ZeroClaw profile only ───────────────────────
# Required only for docker-zeroclaw/local-zeroclaw. It must be a separate
# least-privilege key authorized only for the robot-action alias.
ZEROCLAW_LITELLM_VIRTUAL_KEY=

# ── Conditional online speech providers ─────────────────────
# Leave blank unless the corresponding ASR/TTS backend is enabled.
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=

# ── Optional external robot services ────────────────────────
# Leave blank unless configured. Container deployments must use a DNS name or
# URL reachable from askme-net; localhost would point back to the AskMe container.
NAV_GATEWAY_URL=
DOG_CONTROL_SERVICE_URL=
DOG_SAFETY_SERVICE_URL=
ASKME_EDGE_SERVICE_URL=
NOVA_DOG_RUNTIME_API_KEY=

# ── Runtime authentication (optional) ───────────────────────
RUNTIME_BEARER_TOKEN=
RUNTIME_OPERATOR_ID=askme
