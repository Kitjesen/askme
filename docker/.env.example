# ─────────────────────────────────────────────────────────────
# askme + ZeroClaw — Docker 环境变量模板
# 复制到 .env 并填入实际值后启动：
#   docker compose --env-file .env up -d
# ─────────────────────────────────────────────────────────────

# ── LLM Backend (required) ───────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://cursor.scihub.edu.kg/api/v1

# ── MiniMax (required for fast voice TTS/LLM) ────────────────
MINIMAX_API_KEY=

# ── DashScope / Alibaba Cloud ASR ────────────────────────────
DASHSCOPE_API_KEY=

# ── TTS Voice Settings ────────────────────────────────────────
TTS_VOICE_ID=male-qn-qingse
TTS_SPEED=1
TTS_EMOTION=happy

# ── Navigation Service (optional) ────────────────────────────
NAV_GATEWAY_URL=http://localhost:8088

# ── Robot Control Service (optional) ─────────────────────────
DOG_CONTROL_SERVICE_URL=http://localhost:5080

# ── Safety Service (optional) ────────────────────────────────
DOG_SAFETY_SERVICE_URL=http://localhost:5070

# ── NOVA Dog Runtime Bridge (optional) ──────────────────────
ASKME_EDGE_SERVICE_URL=http://nova_dog:5100
NOVA_DOG_RUNTIME_API_KEY=

# ── OTA Server (optional) ───────────────────────────────────
OTA_SERVER_URL=
NOVA_DOG_SERIAL_NUMBER=

# ── Robot Arm Serial Port (optional) ─────────────────────────
ROBOT_SERIAL_PORT=

# ── Runtime Auth (optional) ─────────────────────────────────
RUNTIME_BEARER_TOKEN=
RUNTIME_OPERATOR_ID=askme

# ── Audio Device (optional) ─────────────────────────────────
# AUDIO_INPUT_DEVICE=0
# AUDIO_OUTPUT_DEVICE=1

# ── ZeroClaw Config ──────────────────────────────────────────
# ZEROCLAW_BIND=0.0.0.0:8080
# ZEROCLAW_ASKME_MCP_URL=http://askme:8765/mcp
