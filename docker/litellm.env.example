# LiteLLM Proxy sidecar environment template.
# Copy to docker/.env.litellm and replace every required placeholder.
# Never copy the master key or provider keys into AskMe's application .env.

LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-master-key
LITELLM_SALT_KEY=replace-with-a-long-stable-random-salt
LITELLM_DATABASE_PASSWORD=replace-with-a-url-safe-database-password

# Existing validated OpenAI-compatible DeepSeek/relay endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Optional. Leave empty when the MiniMax model alias is not used.
MINIMAX_API_KEY=
