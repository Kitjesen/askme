# ─────────────────────────────────────────────────────────────
# askme — Environment Variables Template
# Copy to .env and fill in your values.
# Lines starting with # are comments.
# ─────────────────────────────────────────────────────────────

# ── LLM Backend (required) ───────────────────────────────────
# LLM proxy API key (Claude relay / LiteLLM / OpenAI-compatible)
LLM_API_KEY=

# LLM proxy base URL (OpenAI-compatible / LiteLLM upstream)
LLM_BASE_URL=https://cursor.scihub.edu.kg/api/v1

# LiteLLM application credentials (optional; never use the master key here)
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_VIRTUAL_KEY=

# ── MiniMax (only for app-side TTS or intentional direct-LLM mode) ──
# Get from https://platform.minimax.chat/
MINIMAX_API_KEY=

# DashScope / Alibaba Cloud ASR (optional; required only when Cloud ASR is a deployment gate)
DASHSCOPE_API_KEY=

# Volcengine Doubao streaming ASR (preferred cloud ASR)
# Legacy console uses APP ID + Access Token. Do not configure Secret Key here.
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=
# Seed ASR 2.0: volc.seedasr.sauc.duration or volc.seedasr.sauc.concurrent
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# Volcengine/Doubao end-to-end realtime speech (optional, general chat only)
# These are separate from the ASR credentials above. Keep voice.realtime.enabled=false
# until the account resource is active and shadow-mode acceptance has passed.
VOLCENGINE_S2S_APP_ID=
VOLCENGINE_S2S_ACCESS_TOKEN=

# Volcengine/Doubao TTS V3 bidirectional WebSocket (optional)
# Keep these separate from ASR and end-to-end S2S resources. New console
# accounts should prefer API Key; legacy accounts can use APP ID + Access Key.
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_KEY=
# The granted Resource ID and speaker must match the account's ListSpeakers result.
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEAKER=

# ── TTS Voice Settings ────────────────────────────────────────
TTS_VOICE_ID=male-qn-qingse
TTS_SPEED=1
TTS_EMOTION=happy

# ── Local Embeddings (optional, for memory search) ───────────
LOCAL_EMBED_URL=http://localhost:8000/v1

# ── Navigation Service (optional, enables navigate/mapping skills) ──
# nav-gateway REST API base URL
# Without this, navigation skills will tell the user "服务未配置"
# LingTu 部署时设为 http://localhost:8088
NAV_GATEWAY_URL=http://localhost:8088

# ── Telegram Bot (optional, enables Telegram chat interface) ─────
# 从 @BotFather 获取 token，然后在 config.yaml 中设置 platforms.telegram.enabled: true
TELEGRAM_BOT_TOKEN=

# ── Robot Control Service (optional, enables dog_control skill) ──
# dog-control-service base URL
# Without this, posture commands will tell the user "服务未配置"
DOG_CONTROL_SERVICE_URL=http://localhost:5080

# ── Safety Service (optional, enables E-STOP propagation) ────
# dog-safety-service base URL
DOG_SAFETY_SERVICE_URL=http://localhost:5070

# ── Runtime Auth (optional, required if services use auth) ───
RUNTIME_BEARER_TOKEN=
RUNTIME_OPERATOR_ID=askme

# Control-plane HTTP API auth. Required when health_server.host is not loopback.
ASKME_CONTROL_API_KEY=

# Field operation incident workflow. When webhooks are set, field events send to DingTalk.
ASKME_FIELD_EVENTS_PATH=artifacts/field_ops/events.jsonl
ASKME_DINGTALK_WEBHOOK=
ASKME_DINGTALK_SECURITY_WEBHOOK=
ASKME_DINGTALK_CLEANING_WEBHOOK=
ASKME_DINGTALK_OPERATIONS_WEBHOOK=
ASKME_FIELD_LLM_NARRATIVE=0
# Required for lab/prod runtime callbacks posted to /api/field/events/{event_id}/runtime-delivery.
# The runtime side must sign the callback JSON with HMAC-SHA256 over the unsigned payload.
ASKME_FIELD_RUNTIME_CALLBACK_HMAC_SECRET=

# ── NOVA Dog Runtime Bridge (optional, connects to runtime stack) ──
# askme-edge-service base URL
ASKME_EDGE_SERVICE_URL=http://localhost:8090
# NOVA Dog runtime API key
NOVA_DOG_RUNTIME_API_KEY=

# ── OTA Server (optional, enables remote OTA updates) ────────
# Set when OTA is enabled (ota.enabled: true in config.yaml)
OTA_SERVER_URL=
# Device serial number for OTA registration
NOVA_DOG_SERIAL_NUMBER=

# ── Robot Arm Serial Port (optional, for robot_grab/move skills) ──
# Set to actual serial port when not in simulation mode
# Linux: /dev/ttyUSB0  Windows: COM3
ROBOT_SERIAL_PORT=

# ── Feature Flags (override config.yaml sections) ────────────
# ASKME_FEATURE_ROBOT=0      # 1=enable, 0=disable robot arm
# ASKME_FEATURE_VOICE=1      # 1=enable, 0=disable voice I/O
# ASKME_FEATURE_MEMORY=0     # 1=enable, 0=disable memory/RAG

# ── Custom Config Path (optional) ────────────────────────────
# ASKME_CONFIG_PATH=/path/to/config.yaml

# ── Audio Device (optional, for voice mode) ──────────────────
# Override default audio device index (see: python -m sounddevice)
# AUDIO_INPUT_DEVICE=0
# AUDIO_OUTPUT_DEVICE=1
