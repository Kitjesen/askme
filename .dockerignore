# ── Version control ──────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Python cache / artifacts ────────────────────────────────
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
*.egg-info/
dist/
build/
*.whl

# ── Environment ─────────────────────────────────────────────
.env
.venv
venv/
.venv*/
virtualenv/
.envrc

# ── IDE / editors ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Project-specific ───────────────────────────────────────
# Model files (mounted at runtime via volume)
models/
# Runtime data (mounted at runtime via volume)
data/
memU/
# Test directories (not needed at runtime)
tests/
test-output/

# ── Documentation (not needed at runtime) ───────────────────
docs/

# ── Docker (not needed at runtime; built from docker/) ─────
docker-compose.yml

# ── OS artifacts ──────────────────────────────────────────
.DS_Store
Thumbs.db
