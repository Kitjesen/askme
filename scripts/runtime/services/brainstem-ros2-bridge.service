[Unit]
Description=Brainstem gRPC to ROS2 bridge (joint_states, imu, cmd_vel)
After=network.target
Wants=askme-dds-bridge.service

[Service]
Type=simple
User=sunrise
Environment=PYTHONPATH=/home/sunrise/shared/proto/python
Environment=ASKME_DIR=/home/sunrise/data/inovxio/askme
EnvironmentFile=-/etc/default/askme
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec python3 "${ASKME_DIR}/scripts/runtime/bridges/brainstem_ros2_bridge.py" --host 127.0.0.1 --port 13145'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
