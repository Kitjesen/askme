{
  "name": "askme-video-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Image2Storyboard out/image2-storyboard.mp4",
    "render:product": "remotion render src/index.ts ProductInteractionIntro out/product-interaction-intro.mp4",
    "render:promo": "remotion render src/index.ts NOVAProductPromo out/nova-product-promo.mp4",
    "render:real": "remotion render src/index.ts NOVARealImagePromo out/nova-real-image-promo.mp4",
    "still:product": "remotion still src/index.ts ProductInteractionIntro out/product-frame-150.png --frame=150",
    "still:promo": "remotion still src/index.ts NOVAProductPromo out/nova-promo-frame-270.png --frame=270",
    "still:real": "remotion still src/index.ts NOVARealImagePromo out/nova-real-frame-210.png --frame=210",
    "still": "remotion still src/index.ts Image2Storyboard out/frame-45.png --frame=45",
    "render:preview": "remotion render src/index.ts Image2Storyboard out/image2-storyboard-preview.mp4 --codec=h264 --scale=0.5"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.459",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.459"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
